# =============================================================================
# Digital Banking API - variaveis de ambiente (exemplo)
#
# Copie este arquivo para `.env` ou exporte as variaveis no terminal.
# NUNCA versione credenciais reais.
#
# As variaveis sao lidas por src/main/resources/application.properties:
#   spring.datasource.username=${DB_USERNAME:root}
#   spring.datasource.password=${DB_PASSWORD:}
# =============================================================================

# Usuario do MySQL (opcional; padrao: root)
DB_USERNAME=root

# Senha do MySQL (deixe vazio se o seu usuario nao tiver senha)
DB_PASSWORD=
