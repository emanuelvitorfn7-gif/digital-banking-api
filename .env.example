# =============================================================================
# Digital Banking API - Example environment variables
#
# Copy this file to `.env` (or export the variables in your shell) and fill in
# your own local values. NEVER commit real credentials.
#
# The application reads these placeholders from `application.properties`:
#   spring.datasource.username=${DB_USERNAME:root}
#   spring.datasource.password=${DB_PASSWORD}
#   app.security.admin.username=${APP_ADMIN_USERNAME:admin}
#   app.security.admin.password=${APP_ADMIN_PASSWORD:admin123}
#   app.security.client.username=${APP_CLIENT_USERNAME:cliente}
#   app.security.client.password=${APP_CLIENT_PASSWORD:cliente123}
# =============================================================================

# Database user (optional, defaults to `root` when omitted)
DB_USERNAME=root

# Database password (required - the application fails fast if it is missing)
DB_PASSWORD=change-me

# --- Demo HTTP Basic users (override in any non-local environment) ------------
# ADMIN role: can perform write operations (create, deposit, withdraw, transfer).
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me-admin

# CLIENTE role: read-only access to customers, accounts and statements.
APP_CLIENT_USERNAME=cliente
APP_CLIENT_PASSWORD=change-me-client
