# ---------------------------------------------------------------------------
# Front-End - variaveis de ambiente (copie para .env e ajuste se precisar)
# ---------------------------------------------------------------------------

# Prefixo usado pelo navegador. O padrao "/api" passa pelo proxy de
# desenvolvimento do Vite (ver vite.config.ts), que encaminha para o Back-End.
VITE_API_BASE_URL=/api

# Alvo do proxy de desenvolvimento (usado apenas pelo servidor do Vite).
# Padrao: http://localhost:8081
VITE_API_TARGET=http://localhost:8081
